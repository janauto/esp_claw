    },
    {
      "op": "home_state",
      "expect": {
        "view": "home"
      }
    },
    {
      "shot": "phone_saved_dock_order"
    },
    {
      "shell": "python3 phone_ui.py tap 从背夹重新读取"
    },
    {
      "shell": "python3 phone_ui.py dump"
    },
    {
      "note": "人工核对手机与背夹前两个图标为遥控器/会议录音；记录保存提示、重读顺序，退出手机编辑页再重进核对，主会话另存手机截图。后续默认坐标场景会重新设布局。"
    }
