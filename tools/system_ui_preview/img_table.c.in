/* Generated by CMake: maps carousel image names to the compiled-in copies. */
#include <string.h>
#include "lvgl.h"

@IMG_DECL@
static const struct { const char *name; const lv_image_dsc_t *dsc; } s_imgs[] = {
@IMG_ROWS@
};

const lv_image_dsc_t *preview_find_image(const char *name)
{
    for (size_t i = 0; i < sizeof(s_imgs) / sizeof(s_imgs[0]); i++) {
        if (strcmp(s_imgs[i].name, name) == 0) {
            return s_imgs[i].dsc;
        }
    }
    return NULL;
}
